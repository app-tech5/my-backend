# MongoDB Configuration (local)
# Option 1: Full MongoDB URL
MONGO_URI=mongodb://localhost:27017/your-database-name

# Option 2: Separate parameters (recommended for flexibility)
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=your-database-name
MONGO_DOCKER_CONTAINER=mongodb

# VPS sync (npm run sync:mongo:vps)
VPS_HOST=your-vps-ip
VPS_USER=root
VPS_SSH_KEY=~/.ssh/goodfood_deploy
VPS_MONGO_URI=mongodb://127.0.0.1:27017/your-database-name
VPS_PM2_NAME=my-backend
VPS_BACKUP_BASE=/root/my-backend/backups
LOCAL_BACKUP_BASE=backups

# Server Configuration
PORT=5000

# Secret key for JWT (CHANGE THIS in production!)
JWT_SECRET=your-very-long-and-complex-secret-key-here

# Stripe (required on VPS if payment routes are enabled)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_CONNECT_COUNTRY=FR
STRIPE_CONNECT_RETURN_URL=goodfooddriver://stripe-connect/return
STRIPE_CONNECT_REFRESH_URL=goodfooddriver://stripe-connect/refresh

# Environment (development, staging, production)
NODE_ENV=development

# Intelligence / recommendations provider
# builtin (default) | openai | gemini
AI_PROVIDER=builtin
# Optional override for recommendations only
AI_RECOMMENDATION_PROVIDER=builtin
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_RECOMMENDATION_MODEL=gemini-1.5-flash

# Allowed CORS origins (comma-separated)
# Examples: http://localhost:3000,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Firebase Cloud Messaging (FCM)
# JSON stringified service account credentials (single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project-id.iam.gserviceaccount.com"}

# WhatsApp Cloud API (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=goodfood_whatsapp_verify
WHATSAPP_TEMPLATE_LANG=en
# Configuration de la base de données MongoDB
# Copiez ce fichier vers .env et ajustez les valeurs selon vos besoins

# =================================================================
# BASE DE DONNÉES MONGODB
# =================================================================

# Option 1 : URL complète de MongoDB (avec authentification si nécessaire)
# Format: mongodb://[username:password@]host[:port]/database
MONGO_URI=mongodb://127.0.0.1:27017/good-foods

# Option 2 : Paramètres séparés (recommandé pour la flexibilité)
# Décommentez et ajustez ces lignes si vous préférez
# MONGODB_HOST=127.0.0.1
# MONGODB_PORT=27017
# MONGODB_DATABASE=good-foods
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# =================================================================
# SERVEUR ET SÉCURITÉ
# =================================================================

# Port du serveur backend
PORT=5000

# Clé secrète pour JWT (CHANGEZ-LA en production !)
JWT_SECRET=votre-cle-secrete-très-longue-et-complexe-ici-changez-moi

# =================================================================
# ENVIRONNEMENT
# =================================================================

# Environnement (development, staging, production)
NODE_ENV=development

# =================================================================
# EXEMPLES DE CONFIGURATION
# =================================================================

# Développement local sans authentification :
# MONGO_URI=mongodb://127.0.0.1:27017/good-foods-dev

# Avec authentification locale :
# MONGO_URI=mongodb://admin:password123@localhost:27017/good-foods-prod

# MongoDB Atlas (Cloud) :
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/good-foods?retryWrites=true&w=majority

# Configuration séparée pour Atlas :
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_DATABASE=good-foods
# MONGODB_USERNAME=votre-username-atlas
# MONGODB_PASSWORD=votre-password-atlas